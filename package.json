    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "type": "module",
  "dependencies": {
    "@azure/msal-node": "^7.1.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@vtfk/encryption": "^1.0.3",
    "@vtfk/logger": "^6.4.2",
