{
  "name": "elevdok-svelte-web",
  "version": "1.1.9",
  "private": true,
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
