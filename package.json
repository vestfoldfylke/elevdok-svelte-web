{
  "name": "elevdok-svelte-web",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "node:test": "node --test \"src/**/*.test.ts\"",
    "test": "npm run lint && npm run check && npm run node:test"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "type": "module",
  "dependencies": {
    "@azure/msal-node": "^7.1.1",
    "@vestfoldfylke/loglady": "^2.1.0",
    "@vtfk/encryption": "^1.0.3",
    "mongodb": "^6.21.0",
    "vtfk-schools-info": "^3.4.2"
  }
}
